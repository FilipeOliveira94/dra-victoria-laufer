---
import { indexable } from '../config/release';

interface Props {
  title: string;
}

const { title } = Astro.props;
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    {/* Empty inline icon: stops the browser's automatic /favicon.ico request,
        which would 404 outside the base path. Issue 1.4 adds the real favicon. */}
    <link rel="icon" href="data:," />
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <slot />
  </body>
</html>
