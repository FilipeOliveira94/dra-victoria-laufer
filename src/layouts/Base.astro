---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import displayFont from '../assets/fonts/source-serif-4-latin-600-normal.woff2?url';
import { icon, iconTouch, social } from '../lib/assets';
import { indexable } from '../config/release';
import { crmLabel, medica } from '../lib/content';
import type { Section } from '../lib/sections';

interface Props {
  title: string;
  // Sections shown on this page, in page order. Empty: no navigation.
  nav?: readonly Section[];
  // The 404 page is not a canonical document.
  canonical?: boolean;
}

const { title, nav = [], canonical = true } = Astro.props;
const home = import.meta.env.BASE_URL;
const canonicalUrl = new URL(home, Astro.site);
const id = await medica();
// Description and Open Graph text come from the identification only (issue
// 1.6): name, MÉDICA and CRM. No specialty term can reach them.
const description = id && `${id.nome}, ${id.titulo}, ${crmLabel(id)}.`;
// Open Graph image: the logo on white, from the private assets. Without them,
// no og:image. Absolute, as Open Graph requires; follows DEPLOY_TARGET.
const ogImage = social && (await getImage({ src: social, format: 'png' }));
const ogImageUrl = ogImage && new URL(ogImage.src, Astro.site).href;
// Year of the build, not of the visit: the page ships no JavaScript.
const year = new Date().getFullYear();
// Favicon from the monogram in the private assets (issue 1.4). Without them,
// an empty inline icon stops the automatic /favicon.ico request, which would
// 404 outside the base path.
const favicon = icon && (await getImage({ src: icon, width: 32, height: 32, format: 'png' }));
const touchIcon =
  iconTouch && (await getImage({ src: iconTouch, width: 180, height: 180, format: 'png' }));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonicalUrl.href} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    {id && <meta property="og:site_name" content={id.nome} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonicalUrl.href} />}
    {
      ogImage && ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={String(social?.width)} />
          <meta property="og:image:height" content={String(social?.height)} />
          {id && <meta property="og:image:alt" content={`Logotipo de ${id.nome}`} />}
        </>
      )
    }
    {/* The h1 face: requested with the HTML instead of after the CSS. */}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {
      favicon ? (
        <link rel="icon" href={favicon.src} type="image/png" sizes="32x32" />
      ) : (
        <link rel="icon" href="data:," />
      )
    }
    {touchIcon && <link rel="apple-touch-icon" href={touchIcon.src} />}
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body>
    {/* First stop for the keyboard (issue 1.5). Every page puts its <main> at #conteudo. */}
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    {
      nav.length > 0 && (
        <header class="site-header">
          <nav class="site-nav wrap" aria-label="Seções da página">
            <ul>
              {nav.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.titulo}</a>
                </li>
              ))}
            </ul>
          </nav>
        </header>
      )
    }
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <p>© {year}{id && ` ${id.nome}`}</p>
      </div>
    </footer>
  </body>
</html>
