---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Section from '../components/Section.astro';
import { channelLabel, crmLabel, medica, published } from '../lib/content';
import { section, sections, type SectionId } from '../lib/sections';

// Every fact comes from the content model (issue 1.2). Formação, Atuação and
// Sobre render from issues 2.2 and 2.3; the other channels from 2.1.
const id = await medica();
if (!id) throw new Error('medica is pending: the page cannot be built without identification.');

const email = (await published('contato')).find((c) => c.tipo === 'email');
const identification = `${id.titulo} · ${crmLabel(id)}`;

// A section is on the page, and in the navigation, only with published content.
const present: Record<SectionId, boolean> = {
  formacao: false,
  atuacao: false,
  sobre: false,
  contato: Boolean(email),
};
const nav = sections.filter((s) => present[s.id]);
---

<Base title={`${id.nome} · ${identification}`} nav={nav}>
  <main id="conteudo" tabindex="-1">
    <div class="identification wrap">
      <div class="identification-text">
        <h1>{id.nome}</h1>
        <p>{identification}</p>
      </div>
      <Portrait alt={`Foto de ${id.nome}`} />
    </div>
    {
      email && (
        <Section section={section('contato')}>
          {/* DESIGN.md: the address is the link text and the channel its title.
              A title is not a reliable name, so the channel is also in the
              link text for assistive technology: "E-mail: <address>". */}
          <p>
            <a href={`mailto:${email.valor}`} title={channelLabel.email}>
              <span class="visually-hidden">{channelLabel.email}: </span>
              {email.valor}
            </a>
          </p>
        </Section>
      )
    }
  </main>
</Base>
